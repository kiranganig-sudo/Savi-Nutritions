# =============================================================================
# SAVI Nutrition - Namecheap (cPanel / Passenger) environment
# =============================================================================
# Copy this file to  config/.env  on the server and fill in the real values.
#   cp config/.env.example config/.env
#   chmod 600 config/.env
#
# This file lives OUTSIDE the web root (public_html) and is never committed.
#
# A real environment variable always wins over this file, so cPanel's
# "Setup Python App -> Environment variables" panel works too.
# =============================================================================

# REQUIRED - the live TiDB Cloud database (keep the existing data).
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/test?ssl_verify_cert=true&ssl_verify_identity=true

# REQUIRED - signs the login sessions. At least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# Production switches (the passenger_wsgi.py loader sets these by default).
FLASK_ENV=production
FLASK_DEBUG=0
SAVI_NO_SEED=1

# 1 = login cookies only travel over HTTPS. Turn AutoSSL on BEFORE the first
# login (otherwise the browser drops the cookie and login bounces).
# Set to 0 only while testing over plain http.
SECURE_COOKIE=1

# Shared upload folder for BOTH subdomains. Defaults to <repo>/uploads, which
# is outside both web roots. Uncomment only to move it elsewhere.
#UPLOAD_DIR=/home/USER/savi/uploads

# --- Forgot-Password email OTP (optional) ------------------------------------
# Without these the admin Forgot Password box shows the amber "contact the
# admin" fallback instead of emailing a code.
# SMTP_PASSWORD must be a 16-character Gmail App Password.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=you@gmail.com
#SMTP_PASSWORD=your-16-char-app-password
#MAIL_FROM=you@gmail.com
#ADMIN_RESET_EMAIL=you@gmail.com

# --- Daily backups (optional) ------------------------------------------------
# Defaults to <repo>/backups on Linux. Point the Drive folder at a mounted
# folder if you sync one; leave empty for local-only backups.
#SAVI_BACKUP_DIR=/home/USER/savi/backups

# Local development / offline copy. Copy to `.env` next to this file.
# The hosted Namecheap deployment uses `config/.env` instead (see DEPLOY_NAMECHEAP.md).
#
# Leave DATABASE_URL empty to use the local SQLite file `admin/savi.db`.
DATABASE_URL=
SECRET_KEY=YOUR_STRONG_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS
SECURE_COOKIE=0
SAVI_NO_SEED=1

# Optional S3-compatible upload storage. Leave empty for local disk (`uploads/`).
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
MAX_UPLOAD_BYTES=4194304
